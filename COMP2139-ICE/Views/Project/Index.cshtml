@model IEnumerable<COMP2139_ICE.Models.Project>
@{ ViewData["Title"] = "Projects"; }
<h2>Projects</h2>
<a asp-action="Create" class="btn btn-primary mb-2">Create New Project</a>
@if (Model.Any())
{
    <table class="table">
        <thead><tr><th>ID</th><th>Name</th><th>Description</th><th>Action</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProjectId</td>
                <td>@p.Name</td>
                <td>@p.Description</td>
                <td>
                    <a asp-action="Details" asp-route-id="@p.ProjectId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Delete" asp-route-id="@p.ProjectId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No projects available.</p>
}