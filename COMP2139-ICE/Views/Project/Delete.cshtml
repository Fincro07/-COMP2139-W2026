@model COMP2139_ICE.Models.Project
@{ ViewData["Title"] = "Delete Project"; }
<h2>Delete Project</h2>
<h4>Are you sure you want to delete this project?</h4>
<dl>
    <dt>Name</dt><dd>@Model.Name</dd>
    <dt>Description</dt><dd>@Model.Description</dd>
    <dd>@Model.ProjectId</dd>
</dl>
<form asp-action="DeleteConfirmed" asp-route-id="@Model.ProjectId" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>